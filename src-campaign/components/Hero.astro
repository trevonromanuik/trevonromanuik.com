---
// Hero section — content is intentionally fixed
---

<section id="top" class="hero">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="hero__content container">
    <h1 class="hero__title">Freedom<br/>isn't free</h1>
    <p class="hero__subtitle">but it doesn't have to cost that much</p>
  </div>
  <div class="hero__scroll-hint" aria-hidden="true">↓</div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 75% 50%, rgba(27, 58, 107, 0.55) 0%, transparent 60%),
    linear-gradient(155deg, #08111f 0%, #0d1b35 55%, #111f3a 100%);
  }

  .hero__bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(1px 1px at 12% 18%, rgba(255, 255, 255, 0.45) 0%, transparent 0%),
    radial-gradient(1px 1px at 33% 62%, rgba(255, 255, 255, 0.35) 0%, transparent 0%),
    radial-gradient(1.5px 1.5px at 52% 28%, rgba(255, 255, 255, 0.3) 0%, transparent 0%),
    radial-gradient(1px 1px at 72% 8%, rgba(255, 255, 255, 0.4) 0%, transparent 0%),
    radial-gradient(1px 1px at 88% 52%, rgba(255, 255, 255, 0.35) 0%, transparent 0%),
    radial-gradient(1px 1px at 22% 80%, rgba(255, 255, 255, 0.3) 0%, transparent 0%),
    radial-gradient(1px 1px at 63% 75%, rgba(255, 255, 255, 0.4) 0%, transparent 0%),
    radial-gradient(1px 1px at 92% 32%, rgba(255, 255, 255, 0.3) 0%, transparent 0%),
    radial-gradient(1px 1px at 5% 44%, rgba(255, 255, 255, 0.35) 0%, transparent 0%),
    radial-gradient(1.5px 1.5px at 44% 90%, rgba(255, 255, 255, 0.25) 0%, transparent 0%);
  }

  .hero__bg::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: var(--red);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-top: 8rem;
    padding-bottom: 6rem;
    text-align: center;
  }

  .hero__eyebrow {
    font-family: 'Oswald', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.25rem;
  }

  .hero__title {
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--white);
    line-height: 0.95;
    letter-spacing: 0.01em;
    margin-bottom: 1.1rem;
  }

  .hero__subtitle {
    font-size: clamp(1.1rem, 2.5vw, 1.55rem);
    font-style: italic;
    color: var(--gold);
    font-weight: 400;
    margin-bottom: 2.5rem;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero__cta {
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.85rem 2.25rem;
    border-radius: 3px;
    border: 2px solid var(--red);
    background: var(--red);
    color: var(--white);
    transition: background 0.15s,
    border-color 0.15s,
    transform 0.15s,
    box-shadow 0.15s;
  }

  .hero__cta:hover {
    background: #a50d24;
    border-color: #a50d24;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(200, 16, 46, 0.45);
  }

  .hero__cta--outline {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.45);
  }

  .hero__cta--outline:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--white);
    box-shadow: none;
  }

  .hero__scroll-hint {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.35);
    font-size: 1.5rem;
    animation: bounce 2.2s ease-in-out infinite;
    user-select: none;
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(10px);
    }
  }
</style>


