---
import PolicySection from '@/components/PolicySection.astro';
import type {PolicyCard} from '@/lib/types';

interface Props {
  alt?: boolean;
}

const {alt = false} = Astro.props;

const title = "Food";
const intro = "Food is one of the most basic human needs. None of us can survive without it. Everyone deserves access to nutritious, affordable food, regardless of their postal code or income.";
const cards: PolicyCard[] = [
  {
    icon: '🍲',
    title: 'Community Kitchens',
    text: 'I want to empower communities to come together to feed their members. Community Kitchens would be places where anyone in the community could get a hot cooked meal, whether because they can\'t afford groceries, or simply because they don\'t have time to cook for themselves.',
  },
  {
    icon: '🚜',
    title: 'Local Farmers',
    text: 'Modern society could not exist without our farmers, full stop. Unfortunately big business is squeezing our small farmers, making it harder and harder to make a living providing food for the population. I want to turn farming back into the noble profession that it truly is.',
  },
  {
    icon: '🌱',
    title: 'Community Gardens',
    text: 'On top of supporting farmers, I also want to empower communities to build and maintain community gardens. While they could never compete with large scale farming, a community that grows its own food is a more resilient community.',
  },
];
---

<PolicySection alt={alt} title={title} intro={intro} cards={cards}/>

