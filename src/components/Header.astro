---
// Header / hero section — content is intentionally fixed
---

<section id="top" class="header">
  <div class="header__bg" aria-hidden="true"></div>
  <div class="header__content container">
    <div class="header__text">
      <h1 class="header__name">Trevon<br/>Romanuik</h1>
      <p class="header__tagline">Software Developer. Neighbour. Community Builder.</p>
      <p class="header__intro">
        I believe in showing up - for my community, my neighbours, and the
        people who need a hand. This is a little bit about who I am and what
        I care about.
      </p>
      <a class="header__cta" href="#background">Learn more</a>
    </div>
    <div class="header__portrait" aria-hidden="true">
      <img src="/_DSC9018-Edit.jpg" alt="Trevon Romanuik" class="header__portrait-img" />
    </div>
  </div>
  <div class="header__scroll-hint" aria-hidden="true">↓</div>
</section>

<style>
  .header {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .header__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 70% 50%, rgba(46, 94, 82, 0.5) 0%, transparent 60%),
      linear-gradient(150deg, #0d1f1a 0%, #1a3c34 55%, #1e4038 100%);
  }

  .header__bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.4) 0%, transparent 0%),
      radial-gradient(1px 1px at 30% 65%, rgba(255,255,255,0.3) 0%, transparent 0%),
      radial-gradient(1.5px 1.5px at 55% 25%, rgba(255,255,255,0.25) 0%, transparent 0%),
      radial-gradient(1px 1px at 74% 10%, rgba(255,255,255,0.35) 0%, transparent 0%),
      radial-gradient(1px 1px at 88% 55%, rgba(255,255,255,0.3) 0%, transparent 0%),
      radial-gradient(1px 1px at 20% 82%, rgba(255,255,255,0.25) 0%, transparent 0%),
      radial-gradient(1px 1px at 62% 78%, rgba(255,255,255,0.35) 0%, transparent 0%),
      radial-gradient(1px 1px at 93% 35%, rgba(255,255,255,0.25) 0%, transparent 0%);
  }

  .header__bg::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--amber);
  }

  .header__content {
    position: relative;
    z-index: 1;
    padding-top: 8rem;
    padding-bottom: 6rem;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 4rem;
  }

  .header__text {
    min-width: 0;
  }

  .header__portrait {
    flex-shrink: 0;
    width: clamp(220px, 22vw, 320px);
    align-self: stretch;
    display: flex;
    align-items: center;
  }

  .header__portrait-img {
    width: 100%;
    height: clamp(300px, 55vh, 520px);
    object-fit: cover;
    object-position: center top;
    border-radius: 4px;
    border: 3px solid var(--amber);
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.45);
    display: block;
  }

  .header__eyebrow {
    font-family: 'Oswald', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--amber-light);
    margin-bottom: 1.25rem;
  }

  .header__name {
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--white);
    line-height: 0.95;
    letter-spacing: 0.01em;
    margin-bottom: 1.25rem;
  }

  .header__tagline {
    font-size: clamp(1rem, 2.2vw, 1.35rem);
    font-style: italic;
    color: var(--amber-light);
    font-weight: 400;
    margin-bottom: 1.5rem;
  }

  .header__intro {
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    color: rgba(255, 255, 255, 0.75);
    max-width: 540px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .header__cta {
    display: inline-block;
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.85rem 2.25rem;
    border-radius: 3px;
    border: 2px solid var(--amber);
    background: var(--amber);
    color: var(--white);
    transition: background 0.15s, border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }

  .header__cta:hover {
    background: var(--amber-light);
    border-color: var(--amber-light);
    color: var(--white);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(196, 122, 42, 0.45);
  }

  .header__scroll-hint {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.35);
    font-size: 1.5rem;
    animation: bounce 2.2s ease-in-out infinite;
    user-select: none;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(10px); }
  }

  @media (max-width: 768px) {
    .header__content {
      grid-template-columns: 1fr;
      padding-top: 7rem;
      padding-bottom: 5rem;
      gap: 2.5rem;
    }

    .header__portrait {
      width: 100%;
      justify-content: center;
    }

    .header__portrait-img {
      width: clamp(180px, 55vw, 280px);
      height: clamp(240px, 65vw, 380px);
    }
  }
</style>

