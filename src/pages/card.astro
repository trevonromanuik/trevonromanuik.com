<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link rel="icon" href="/favicon.ico"/>
  <title>Business Card — Trevon Romanuik</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link
    href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&family=Open+Sans:ital,wght@0,400;1,400&display=swap"
    rel="stylesheet"
  />
</head>
<body>

<div class="controls">
  <p class="controls__hint">
    Use <em>File → Print</em> and set the paper size to
    <strong>3.75 × 2.25 in</strong>, or choose <em>Save as PDF</em>.
  </p>
  <button class="controls__btn" id="print-btn">Print / Save as PDF</button>
</div>

<main class="preview">
  <div class="card">
    <div class="card__left">
      <h1 class="card__name">Trevon<br/>Romanuik</h1>
      <p class="card__tagline">Software Developer<br/>Neighbour<br/>Community Builder</p>
      <p class="card__url">trevonromanuik.com</p>
    </div>
    <div class="card__right">
      <img
        class="card__qr"
        src="/images/qr-code.png"
        alt="QR code linking to trevonromanuik.com"
        width="400"
        height="400"
      />
    </div>
  </div>
</main>

</body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --forest: #1a3c34;
    --amber: #c47a2a;
    --amber-light: #e09040;
    --white: #ffffff;
  }

  body {
    background: #d0d0d0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 2rem;
    font-family: 'Open Sans', sans-serif;
  }

  .controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .controls__hint { font-size: 0.875rem; color: #444; }

  .controls__btn {
    font-family: 'Oswald', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.65rem 1.75rem;
    border-radius: 3px;
    border: 2px solid var(--amber);
    background: var(--amber);
    color: var(--white);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }

  .controls__btn:hover { background: var(--amber-light); border-color: var(--amber-light); }

  /* Card preview shell — full page with 0.125in bleed on all sides */
  .preview {
    width: 3.75in;
    height: 2.25in;
    padding: 0.125in;
    background: var(--forest);
    border-radius: 6px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    overflow: hidden;
  }

  .card {
    width: 100%;
    height: 100%;
    background: var(--forest);
    display: flex;
    align-items: stretch;
    border-left: 5px solid var(--amber);
  }

  .card__left {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.2in 0.1in 0.2in 0.22in;
  }

  .card__name {
    font-family: 'Oswald', sans-serif;
    font-size: 0.37in;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--white);
    line-height: 1.05;
    letter-spacing: 0.01em;
  }

  .card__tagline {
    font-size: 0.095in;
    font-style: italic;
    color: var(--amber-light);
    line-height: 1.5;
  }

  .card__url {
    font-family: 'Oswald', sans-serif;
    font-size: 0.095in;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.6);
  }

  .card__right {
    width: 1.5in;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.2in 0.17in 0.2in 0;
  }

  .card__qr {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }

  @media print {
    @page { size: 3.75in 2.25in; margin: 0; }

    body { background: none; padding: 0; min-height: unset; }

    .controls { display: none; }

    .preview { box-shadow: none; border-radius: 0; }
  }
</style>

<script>
  document.getElementById('print-btn')?.addEventListener('click', () => {
    window.print();
  });
</script>

