---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Trevon Romanuik',
  description = 'Software Developer, Neighbour, and Community Builder based in Edmonton.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <link rel="icon" href="/favicon.ico"/>
  <meta name="description" content={description}/>
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link
    href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Open+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    rel="stylesheet"
  />
</head>
<body>
<slot/>
</body>
</html>

<style is:global>
  :root {
    --forest: #1a3c34;
    --forest-mid: #2e5e52;
    --amber: #c47a2a;
    --amber-light: #e09040;
    --cream: #f7f5f0;
    --white: #ffffff;
    --text-dark: #1c1c1e;
    --text-muted: #6b6b6e;
    --border: #dedad3;
    --max-width: 1100px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Open Sans', sans-serif;
    color: var(--text-dark);
    background: var(--white);
    line-height: 1.6;
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: 'Oswald', sans-serif;
    line-height: 1.15;
    letter-spacing: 0.03em;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a[href] {
    color: var(--amber);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }

  a[href]:hover {
    color: var(--amber-light);
    text-decoration-color: currentColor;
  }

  img {
    max-width: 100%;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section {
    padding: 5rem 0;
  }

  .section--alt {
    background: var(--cream);
  }

  .section-label {
    font-family: 'Oswald', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--forest);
    margin-bottom: 1rem;
  }

  .section-accent {
    width: 4rem;
    height: 4px;
    background: var(--amber);
    margin-top: 0.75rem;
    margin-bottom: 2rem;
  }

  .section-body {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
    margin: 1rem 0;
    max-width: 720px;
  }

  .section-quote {
    font-size: clamp(1.35rem, 2.8vw, 2rem);
    font-style: italic;
    color: var(--forest);
    line-height: 1.45;
    padding: 0.75rem 1.75rem;
    margin-block: 2rem;
    max-width: 680px;
  }
</style>

