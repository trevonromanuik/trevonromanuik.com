---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Trevon Romanuik",
	description = "TODO",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Open+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--navy: #0d1b35;
		--blue: #1b3a6b;
		--red: #c8102e;
		--gold: #f0a500;
		--white: #ffffff;
		--off-white: #f4f5f7;
		--text-dark: #1a1a2e;
		--text-muted: #5a6070;
		--border: #e0e4ed;
		--max-width: 1100px;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: 'Open Sans', sans-serif;
		color: var(--text-dark);
		background: var(--white);
		line-height: 1.6;
	}

	h1,
	h2,
	h3,
	h4 {
		font-family: 'Oswald', sans-serif;
		line-height: 1.15;
		letter-spacing: 0.03em;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	img {
		max-width: 100%;
	}

	.container {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 2rem;
	}

	.section {
		padding: 5rem 0;
	}

	.section--alt {
		background: var(--off-white);
	}

	.section-label {
		font-family: 'Oswald', sans-serif;
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--red);
		margin-bottom: 0.5rem;
	}

	.section-title {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 700;
		text-transform: uppercase;
		color: var(--navy);
		margin-bottom: 1rem;
	}

	.section-accent {
		width: 4rem;
		height: 4px;
		background: var(--red);
		margin-top: 0.75rem;
		margin-bottom: 2rem;
	}

	.section-intro {
		max-width: 700px;
		color: var(--text-muted);
		font-size: 1.05rem;
		line-height: 1.75;
		margin-bottom: 3rem;
	}

	.policy-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.5rem;
	}

	.policy-card {
		background: var(--white);
		border-radius: 6px;
		padding: 1.75rem;
		border: 1px solid var(--border);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
		transition:
			transform 0.2s,
			box-shadow 0.2s;
	}

	.section--alt .policy-card {
		background: var(--white);
	}

	.policy-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
	}

	.policy-card__icon {
		font-size: 2rem;
		margin-bottom: 0.75rem;
	}

	.policy-card__title {
		font-family: 'Oswald', sans-serif;
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--navy);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.6rem;
	}

	.policy-card__text {
		font-size: 0.95rem;
		color: var(--text-muted);
		line-height: 1.65;
	}
</style>
